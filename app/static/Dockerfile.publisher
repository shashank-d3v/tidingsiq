FROM asia-south1-docker.pkg.dev/tidingsiq-dev/tidingsiq-pipeline/tidingsiq-bruin@sha256:2c30b9a37ed94baaa72776f8e8aa1485476c6a9097388a5842d744b53ceef15c
COPY --chown=tidingsiq:tidingsiq publish_static_feed.py /workspace/scripts/publish_static_feed.py
